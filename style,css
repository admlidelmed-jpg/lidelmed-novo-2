body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f5f5;
}

header {
    background: #FFD700;
    color: #FF0000;
    text-align: center;
    padding: 12px;
}

header h1 { 
    margin: 0; 
    font-size: 22px; 
    font-weight: bold; 
}

header p { 
    margin: 3px 0 0 0; 
    color: #FF0000; 
    font-size: 12px;
}

/* FORÇA 2 COLUNAS E DEIXA PEQUENO */
#grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important; /* 2 COLUNAS FORÇADAS */
    gap: 10px !important;
    padding: 10px !important;
    max-width: 500px !important; /* DIMINUI MUITO */
    margin: 15px auto !important;
}

.card {
    background: #FFFDDC !important;
    border-radius: 6px !important;
    padding: 8px !important;
    box-shadow: 0 1px 4px rgba(0,0,0,0.1) !important;
    text-align: center !important;
}

/* FOTO BEM MENOR */
.card img {
    width: 100% !important;
    height: 80px !important; /* BEM PEQUENA */
    object-fit: contain !important;
    border-radius: 4px !important;
    margin-bottom: 6px !important;
}

.card h3 {
    font-size: 12px !important; /* LETRA PEQUENA */
    margin: 5px 0 !important;
    color: #B22222 !important;
    line-height: 1.2 !important;
    min-height: 28px !important;
}

.preco {
    font-size: 14px !important;
    font-weight: bold !important;
    color: #FF7000 !important;
    margin: 3px 0 !important;
}

.cartao {
    font-size: 11px !important;
    color: #666 !important;
    margin: 3px 0 8px 0 !important;
}

/* BOTÃO PEQUENO */
.btn-whats {
    background: #25D366 !important;
    color: white !important;
    padding: 6px !important;
    width: 100% !important;
    border-radius: 5px !important;
    font-weight: bold !important;
    font-size: 12px !important;
    text-decoration: none !important;
    display: block !important;
}

.btn-whats:hover {
    background: #1da851 !important;
}
