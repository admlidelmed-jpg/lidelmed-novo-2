body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f5f5;
}

header {
    background: #FFD700; /* AMARELO */
    color: #FF0000; /* VERMELHO */
    text-align: center;
    padding: 15px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

header h1 { 
    margin: 0; 
    font-size: 24px; 
    font-weight: bold; 
}

header p { 
    margin: 5px 0 0 0; 
    color: #FF0000; 
    font-size: 13px;
}

/* AQUI QUE MUDA: 2 COLUNAS E MENOR */
#grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* FORÇA 2 COLUNAS */
    gap: 15px;
    padding: 15px;
    max-width: 700px; /* DIMINUI A LARGURA TOTAL */
    margin: 20px auto;
}

.card {
    background: #FFFDDC;
    border-radius: 8px;
    padding: 10px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    text-align: center;
    transition: transform 0.2s;
    cursor: pointer;
}

.card:hover {
    transform: translateY(-3px);
}

/* FOTO MENOR */
.card img {
    width: 100%;
    height: 120px; /* DIMINUI DE 200px PRA 120px */
    object-fit: contain;
    border-radius: 6px;
    margin-bottom: 8px;
}

.card h3 {
    font-size: 14px; /* DIMINUI A LETRA */
    margin: 8px 0;
    color: #B22222;
    min-height: 32px;
}

.preco {
    font-size: 16px;
    font-weight: bold;
    color: #FF7000;
    margin: 4px 0;
}

.cartao {
    font-size: 12px;
    color: #666;
    margin: 4px 0 10px 0;
}

/* BOTÃO MENOR TAMBÉM */
.btn-whats {
    background: #25D366;
    color: white;
    border: none;
    padding: 8px;
    width: 100%;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    font-size: 13px;
    text-decoration: none;
    display: block;
}

.btn-whats:hover {
    background: #1da851;
}
