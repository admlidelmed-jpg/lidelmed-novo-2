body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f5f5;
}

header {
    background: #FFD700; /* AMARELO */
    color: #FF0000; /* VERMELHO */
    text-align: center;
    padding: 15px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

header h1 { 
    margin: 0; 
    font-size: 28px; 
    font-weight: bold; 
}

header p { 
    margin: 5px 0 0 0; 
    color: #FF0000; 
    font-size: 14px;
}

#grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    padding: 20px;
    max-width: 1200px;
    margin: 20px auto;
}

.card {
    background: #FFFDDC;
    border-radius: 10px;
    padding: 15px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    text-align: center;
    overflow: hidden;
    transition: transform 0.2s;
    cursor: pointer;
}

.card:hover {
    transform: translateY(-5px);
}

.card img {
    width: 100%;
    height: 200px;
    object-fit: contain;
    border-radius: 8px;
    margin-bottom: 10px;
    cursor: pointer;
}

.card h3 {
    font-size: 16px;
    margin: 10px 0;
    color: #B22222;
    min-height: 40px;
}

.preco {
    font-size: 18px;
    font-weight: bold;
    color: #FF7000;
    margin: 5px 0;
}

.cartao {
    font-size: 14px;
    color: #666;
    margin: 5px 0 15px 0;
}

/* BOTÃO DO WHATSAPP - QUE TAVA FALTANDO */
.btn-whats {
    background: #25D366;
    color: white;
    border: none;
    padding: 12px;
    width: 100%;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
    font-size: 15px;
    transition: background 0.2s;
    text-decoration: none;
    display: block;
}

.btn-whats:hover {
    background: #1da851;
}

/* MODAL */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.7);
}
