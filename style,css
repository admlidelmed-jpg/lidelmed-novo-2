body{background:#B22222 !important; margin:0 !important;}
header{background:#FFD700 !important; color:#B22222 !important; text-align:center !important; padding:5px !important;}
header h1{font-size:15px !important; margin:0 !important;}

/* FORÇA 2 COLUNAS */
main {
    display:grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap:5px !important;
    padding:5px !important;
}

/* CARD MINÚSCULO */
.card, .produto {
    background:white !important;
    border-radius:3px !important;
    padding:3px !important;
    margin:0 !important;
}

/* FOTO BEM PEQUENA */
.card img, .produto img{
    width:100% !important;
    height:40px !important; /* DIMINUI AQUI */
    object-fit:contain !important;
}

/* TEXTO MINÚSCULO */
.card h3, .produto h3{
    font-size:8px !important; 
    color:#B22222 !important; 
    margin:2px 0 !important;
    height:16px !important;
    overflow:hidden !important;
}
.preco{font-size:9px !important; color:#FF7000 !important; font-weight:bold; margin:1px !important;}
.cartao{font-size:7px !important; color:#666 !important; margin:1px !important;}
.btn-whats, button{
    background:#25D366 !important; 
    color:white !important; 
    padding:2px !important; 
    font-size:7px !important; 
    border-radius:2px !important;
    width:100% !important;
    display:block !important;
}
